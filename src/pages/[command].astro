---
import PortfolioApp from "@/components/portfolio/PortfolioApp";
import AppLayout from "@/layouts/AppLayout.astro";
import { ROUTABLE_COMMANDS } from "@/lib/constants/commands.constants";
import { findRoutableCommand } from "@/lib/helpers/commands";

export function getStaticPaths() {
  return ROUTABLE_COMMANDS.map((command) => ({
    params: { command: command.name },
  }));
}

const { command } = Astro.params;
const initialRoute =
  command === undefined ? null : findRoutableCommand(command);
---

<AppLayout title={command}>
  <PortfolioApp client:load initialRoute={initialRoute} />
</AppLayout>
